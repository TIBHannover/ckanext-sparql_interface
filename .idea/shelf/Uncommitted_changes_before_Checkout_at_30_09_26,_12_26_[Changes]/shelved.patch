<+>name: Tests\non: [push, pull_request]\n\njobs:\n  lint:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2\n      - uses: actions/setup-python@v5\n        with:\n          python-version: '3.9'\n      - name: Install requirements\n        run: pip install flake8 pycodestyle --no-cache-dir\n      #- name: Check syntax\n      #  run: flake8 . --count --select=E901,E999,F821,F822,F823 --show-source --statistics --exclude ckan\n      #- name: Run flake8\n      #  run: flake8 . --count --max-line-length=127 --statistics --exclude ckan\n\n  test:\n    needs: lint\n    strategy:\n      matrix:\n        include:\n          - ckan-version: \"2.9.11\"\n            python-version: \"3.9\"\n            postgres-version: \"2.9\"\n            solr-version: \"2.9-solr8\"\n            pytest-plugins: \"-p ckan.tests.pytest_ckan.ckan_setup -p ckan.tests.pytest_ckan.fixtures\"\n          - ckan-version: \"2.10.7\"\n            python-version: \"3.10\"\n            postgres-version: \"2.10\"\n            solr-version: \"2.10-solr9\"\n            pytest-plugins: \"-p ckan.tests.pytest_ckan.ckan_setup -p ckan.tests.pytest_ckan.fixtures\"\n          - ckan-version: \"2.11.6\"\n            python-version: \"3.10\"\n            postgres-version: \"2.11\"\n            solr-version: \"2.11-solr9\"\n            pytest-plugins: \"\"\n      fail-fast: false\n\n    name: CKAN ${{ matrix.ckan-version }}\n    runs-on: ubuntu-latest\n    container:\n      image: ckan/ckan-dev:${{ matrix.ckan-version }}\n      options: --user root\n    services:\n      solr:\n        image: ckan/ckan-solr:${{ matrix.solr-version }}\n        options: >-\n          --health-cmd \"wget -qO /dev/null http://localhost:8983/solr/\"\n          --health-interval 10s\n          --health-timeout 5s\n          --health-retries 5\n      postgres:\n        image: ckan/ckan-postgres-dev:${{ matrix.postgres-version }}\n        env:\n          POSTGRES_USER: postgres\n          POSTGRES_PASSWORD: postgres\n          POSTGRES_DB: postgres\n        options: >-\n          --health-cmd \"pg_isready\"\n          --health-interval 10s\n          --health-timeout 5s\n          --health-retries 5\n      redis:\n        image: redis:3\n        options: >-\n          --health-cmd \"redis-cli ping\"\n          --health-interval 10s\n          --health-timeout 5s\n          --health-retries 5\n\n    env:\n      CKAN_SQLALCHEMY_URL: postgresql://ckan_default:pass@postgres/ckan_test\n      CKAN_DATASTORE_WRITE_URL: postgresql://datastore_write:pass@postgres/datastore_test\n      CKAN_DATASTORE_READ_URL: postgresql://datastore_read:pass@postgres/datastore_test\n      CKAN_SOLR_URL: http://solr:8983/solr/ckan\n      CKAN_REDIS_URL: redis://redis:6379/1\n\n    steps:\n    # CKAN 2.9's Alpine image cannot execute the runner's Node 24 binary.\n    - name: Checkout repository without a JavaScript action\n      env:\n        GH_TOKEN: ${{ github.token }}\n      run: |\n        auth_header=\"$(printf 'x-access-token:%s' \"$GH_TOKEN\" | base64 | tr -d '\\n')\"\n        git config --global --add safe.directory \"$GITHUB_WORKSPACE\"\n        git init .\n        git remote add origin \"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY\"\n        git -c http.extraheader=\"AUTHORIZATION: basic $auth_header\" \\\n          fetch --no-tags --depth=1 origin \"$GITHUB_SHA\"\n        git checkout --detach FETCH_HEAD\n    - name: Install Python dependencies\n      run: |\n        python3 -c \"import sys; assert sys.version_info[:2] == tuple(map(int, '${{ matrix.python-version }}'.split('.')))\"\n        pip install --upgrade pip 'setuptools<81' --no-cache-dir\n        pip install -r requirements.txt\n        pip install -e . --no-cache-dir\n        # Replace default path to CKAN core config file with the one on the container\n        sed -i -e 's/use = config:.*/use = config:\\/srv\\/app\\/src\\/ckan\\/test-core.ini/' test.ini\n        # GitHub Actions service aliases differ from the docker-ckan Compose aliases.\n        sed -i -e 's/@db\\//@postgres\\//g' test.ini\n    - name: Setup extension (CKAN >= 2.9)\n      run: |\n        ckan -c test.ini db upgrade\n        ckan -c test.ini db pending-migrations --apply\n    - name: Run tests\n      run: >-\n        pytest\n        ${{ matrix.pytest-plugins }}\n        --ckan-ini=test.ini\n        --cov=ckanext.sparql_interface\n        --disable-warnings\n        ckanext/sparql_interface/tests\n
